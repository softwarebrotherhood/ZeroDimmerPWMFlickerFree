<Window x:Class="AntiFlickerDimmer.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlickerFree Dimmer"
        Width="460"
        Height="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#0F172A"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        Icon="app.ico">

    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#475569"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PresetChip" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#38BDF8"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <!-- Main Container -->
    <Border Background="#0F172A" 
            BorderBrush="#38BDF8" 
            BorderThickness="2" 
            Padding="20"
            SnapsToDevicePixels="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="*"/>    <!-- Scrollable Content -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Title Bar (Draggable) -->
            <Grid Grid.Row="0" MouseLeftButtonDown="OnTitleBarMouseDown" Background="Transparent" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" Background="Transparent" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Image Source="app.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="FlickerFree Dimmer" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <TextBlock Text="Zero-Flicker PWM Screen Dimmer" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>

                <!-- Window Control Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Width="32" Height="32" Click="OnMinimizeClick" Style="{StaticResource ModernButton}" Background="Transparent" Padding="0" Margin="0,0,4,0" ToolTip="Minimize to Tray">
                        <TextBlock Text="—" Foreground="#94A3B8" FontWeight="Bold" FontSize="14"/>
                    </Button>
                    <Button Width="32" Height="32" Click="OnCloseToTrayClick" Style="{StaticResource ModernButton}" Background="Transparent" Padding="0" ToolTip="Close to Tray (Keeps Dimmer Running)">
                        <TextBlock Text="✕" Foreground="#94A3B8" FontWeight="Bold" FontSize="14"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Main Content Area -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    
                    <!-- Card 1: Power & Dimming Control -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <!-- Master Switch Row -->
                            <Grid Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Dimmer Status:" FontSize="13" FontWeight="SemiBold" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                    <Border x:Name="StatusBadge" Background="#14532D" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="StatusBadgeText" Text="ACTIVE" FontSize="11" FontWeight="Bold" Foreground="#4ADE80"/>
                                    </Border>
                                </StackPanel>
                                <Button x:Name="PowerToggleButton" Click="OnPowerToggleClick" Style="{StaticResource ModernButton}" Background="#0284C7" HorizontalAlignment="Right" Padding="14,6">
                                    <TextBlock x:Name="PowerButtonText" Text="Turn Off" FontWeight="Bold"/>
                                </Button>
                            </Grid>

                            <!-- Percentage & Stepper -->
                            <Grid Margin="0,0,0,10">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="DimLevelText" Text="35%" FontSize="36" FontWeight="ExtraBold" Foreground="#38BDF8"/>
                                    <TextBlock Text="Software Darkness Overlay" FontSize="11" Foreground="#64748B"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Width="36" Height="36" Click="OnDecrementDimClick" Style="{StaticResource ModernButton}" Content="-" FontSize="18" Margin="0,0,8,0"/>
                                    <Button Width="36" Height="36" Click="OnIncrementDimClick" Style="{StaticResource ModernButton}" Content="+" FontSize="18"/>
                                </StackPanel>
                            </Grid>

                            <!-- Slider -->
                            <Slider x:Name="DimSlider" 
                                    Minimum="0" 
                                    Maximum="90" 
                                    Value="35" 
                                    SmallChange="1" 
                                    LargeChange="5"
                                    ValueChanged="OnDimSliderValueChanged" 
                                    Margin="0,0,0,14"
                                    Height="24"/>

                            <!-- Quick Presets -->
                            <TextBlock Text="QUICK PRESETS" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                            <UniformGrid Columns="5" Margin="0,0,0,4">
                                <Button Content="Off (0%)" Style="{StaticResource PresetChip}" Click="OnPresetClick" Tag="0"/>
                                <Button Content="20%" Style="{StaticResource PresetChip}" Click="OnPresetClick" Tag="20"/>
                                <Button Content="40%" Style="{StaticResource PresetChip}" Click="OnPresetClick" Tag="40"/>
                                <Button Content="60%" Style="{StaticResource PresetChip}" Click="OnPresetClick" Tag="60"/>
                                <Button Content="80%" Style="{StaticResource PresetChip}" Click="OnPresetClick" Tag="80"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Dimming Scope & Taskbar Coverage -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="DIMMING SCOPE (TASKBAR &amp; MENUS)" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8"/>
                            <RadioButton x:Name="ModeDwmRadio" Content="Full Desktop &amp; Taskbar (Recommended)" GroupName="MethodGroup" Foreground="#38BDF8" FontWeight="SemiBold" Margin="0,0,0,4" IsChecked="True" Checked="OnDimmerMethodChanged" Tag="Dwm"/>
                            <TextBlock Text="Dims everything uniformly: Taskbar, Start Menu, right-click context menus, and Windows popups. No bright leaks!" FontSize="11" Foreground="#94A3B8" Margin="20,0,0,10" TextWrapping="Wrap"/>
                            <RadioButton x:Name="ModeOverlayRadio" Content="Window Overlay Only" GroupName="MethodGroup" Foreground="#CBD5E1" Margin="0,0,0,2" Checked="OnDimmerMethodChanged" Tag="Overlay"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Tint & Color Mode -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="COLOR TINT" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8"/>
                            <WrapPanel Orientation="Horizontal">
                                <RadioButton x:Name="TintBlackRadio" Content="Neutral Black" GroupName="TintGroup" Foreground="#F8FAFC" Margin="0,0,16,8" IsChecked="True" Checked="OnTintRadioChanged" Tag="NeutralBlack"/>
                                <RadioButton x:Name="TintAmberRadio" Content="Warm Amber" GroupName="TintGroup" Foreground="#F59E0B" Margin="0,0,16,8" Checked="OnTintRadioChanged" Tag="WarmAmber"/>
                                <RadioButton x:Name="TintCandleRadio" Content="Cozy Candle" GroupName="TintGroup" Foreground="#F97316" Margin="0,0,16,8" Checked="OnTintRadioChanged" Tag="Candle"/>
                                <RadioButton x:Name="TintGreenRadio" Content="Soft Green" GroupName="TintGroup" Foreground="#10B981" Margin="0,0,0,8" Checked="OnTintRadioChanged" Tag="SoftGreen"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Anti-PWM Flicker Tip -->
                    <Border Background="#172554" BorderBrush="#1E40AF" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="💡" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="How to eliminate screen flicker:" FontSize="12" FontWeight="Bold" Foreground="#93C5FD"/>
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#BFDBFE" LineHeight="16">
                                Keep your laptop screen's hardware brightness (Fn keys) set to 100%. At 100%, PWM pulsing stops completely. Then, adjust this app's slider to comfortably reduce the screen light without causing any eye strain or flickering!
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Card 4: Global Hotkeys & Preferences -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="HOTKEYS &amp; PREFERENCES" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Ctrl + Alt + Down" Foreground="#94A3B8" FontSize="11"/>
                                <TextBlock Text="Dim screen (+5%)" Foreground="#CBD5E1" FontSize="11" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Ctrl + Alt + Up" Foreground="#94A3B8" FontSize="11"/>
                                <TextBlock Text="Brighten screen (-5%)" Foreground="#CBD5E1" FontSize="11" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Ctrl + Alt + D" Foreground="#94A3B8" FontSize="11"/>
                                <TextBlock Text="Toggle Dimmer On/Off" Foreground="#CBD5E1" FontSize="11" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Ctrl + Alt + Esc" Foreground="#94A3B8" FontSize="11"/>
                                <TextBlock Text="Emergency Reset (0%)" Foreground="#CBD5E1" FontSize="11" HorizontalAlignment="Right"/>
                            </Grid>

                            <Separator Background="#334155" Margin="0,4,0,10"/>

                            <CheckBox x:Name="StartupCheckBox" Content="Start automatically with Windows" Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,6" Checked="OnStartupCheckChanged" Unchecked="OnStartupCheckChanged"/>
                            <CheckBox x:Name="ShowOsdCheckBox" Content="Show on-screen display (OSD) on hotkey press" Foreground="#CBD5E1" FontSize="12" Checked="OnShowOsdCheckChanged" Unchecked="OnShowOsdCheckChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 5: UAC "Run as Admin" Dimming -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="🔒" FontSize="13" Margin="0,0,6,0"/>
                                <TextBlock Text="DIM 'RUN AS ADMIN' (UAC) POPUPS" FontSize="10" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,10" LineHeight="16">
                                By default, Windows switches to an isolated "Secure Desktop" for administrator prompts, which temporarily turns off all software dimmers. Click below to allow FlickerFree Dimmer to dim administrator popups too.
                            </TextBlock>
                            <Button Content="Dim Administrator Popups" Click="OnFixUacClick" Style="{StaticResource ModernButton}" Background="#0284C7" HorizontalAlignment="Left" Padding="14,6"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Button Content="Hide to Tray" Click="OnCloseToTrayClick" Style="{StaticResource ModernButton}" HorizontalAlignment="Left" Background="#1E293B" Foreground="#94A3B8" Padding="14,6"/>
                <Button Content="Quit Dimmer" Click="OnQuitClick" Style="{StaticResource ModernButton}" HorizontalAlignment="Right" Background="#7F1D1D" Foreground="#FECACA" Padding="14,6"/>
            </Grid>
        </Grid>
    </Border>
</Window>
