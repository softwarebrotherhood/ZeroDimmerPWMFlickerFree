# Ignore compiler intermediates and debug builds
obj/
bin/Debug/

# Visual Studio / Rider / VSCode caches
.vs/
.vscode/
.idea/
*.user
*.suo
*.userprefs
*.dbmdl

# Logs and temp files
*.log
*.tmp
debug.log

# Operating System files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Python caches
__pycache__/
*.py[cod]

# macOS build files
.build/
.DS_Store
*.xcworkspace
xcuserdata/

# Linux package outputs
*.tar.gz
