    def on_enable_toggled(self, switch, state):
        self.scale.set_sensitive(state)
        self.engine.update(self.scale.get_value(), state, self.engine.tint, self.engine.mode)

    def on_slider_changed(self, scale):
        val = int(scale.get_value())
        self.val_label.set_text(f"{val}%")
        self.engine.update(val, self.enable_switch.get_active(), self.engine.tint, self.engine.mode)

    def make_preset_handler(self, target_val):
        def handler(button):
            self.scale.set_value(target_val)
        return handler

    def make_tint_handler(self, tint_id):
        def handler(button):
            for tid, btn in self.tint_buttons.items():
                if tid == tint_id:
                    btn.get_style_context().add_class("tint-active")
                else:
                    btn.get_style_context().remove_class("tint-active")
            self.engine.update(self.scale.get_value(), self.enable_switch.get_active(), tint_id, self.engine.mode)
        return handler

    def on_mode_changed(self, combo):
        selected_mode = combo.get_active_id() or "auto"
        self.engine.update(self.scale.get_value(), self.enable_switch.get_active(), self.engine.tint, selected_mode)

    def on_hide_to_tray(self, widget, event):
        self.hide()
        return True

    def on_quit(self, button):
        self.engine.cleanup()
        Gtk.main_quit()


class App:
    def __init__(self):
        self.engine = DimmerEngine()
        self.win = MainWindow(self.engine)
        self.setup_tray()

    def setup_tray(self):
        icon_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "app.png")
        if not os.path.exists(icon_path):
            icon_path = "display-brightness-symbolic"

        if HAVE_INDICATOR:
            self.indicator = AppIndicator.Indicator.new(
                "zerodimmer",
                icon_path,
                AppIndicator.IndicatorCategory.APPLICATION_STATUS
            )
            self.indicator.set_status(AppIndicator.IndicatorStatus.ACTIVE)
            menu = Gtk.Menu()

            item_show = Gtk.MenuItem(label="Show Control Center")
            item_show.connect("activate", lambda _: self.win.present())
            menu.append(item_show)

            item_reset = Gtk.MenuItem(label="Reset to 0% (Off)")
            item_reset.connect("activate", lambda _: self.win.scale.set_value(0))
            menu.append(item_reset)

            item_kofi = Gtk.MenuItem(label="Support on Ko-fi ☕")
            item_kofi.connect("activate", lambda _: webbrowser.open("https://ko-fi.com/softwarebrotherhood"))
            menu.append(item_kofi)

            item_quit = Gtk.MenuItem(label="Quit")
            item_quit.connect("activate", self.quit_app)
            menu.append(item_quit)

            menu.show_all()
            self.indicator.set_menu(menu)
        else:
            # Fallback to Gtk.StatusIcon
            try:
                self.status_icon = Gtk.StatusIcon()
                if os.path.exists(icon_path):
                    self.status_icon.set_from_file(icon_path)
                else:
                    self.status_icon.set_from_icon_name("display-brightness-symbolic")
                self.status_icon.connect("activate", lambda _: self.win.present())
            except Exception:
                pass

    def quit_app(self, *args):
        self.engine.cleanup()
        Gtk.main_quit()

    def run(self):
        # Register signal handlers for clean exit
        signal.signal(signal.SIGINT, lambda *_: self.quit_app())
        signal.signal(signal.SIGTERM, lambda *_: self.quit_app())
        atexit.register(self.engine.cleanup)

        self.win.show_all()
        Gtk.main()


if __name__ == "__main__":
    app = App()
    app.run()
