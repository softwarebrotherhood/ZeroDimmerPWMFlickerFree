class DimmerEngine:
    def __init__(self):
        self.level = 0  # 0 to 90
        self.enabled = True
        self.tint = "NeutralBlack"
        self.mode = "auto"  # 'auto', 'xrandr', 'overlay'
        self.is_x11 = os.environ.get("XDG_SESSION_TYPE", "").lower() == "x11" or (
            "DISPLAY" in os.environ and "WAYLAND_DISPLAY" not in os.environ
        )
        self.active_outputs = self._detect_xrandr_outputs()
        self.overlay_windows = []

    def _detect_xrandr_outputs(self):
        outputs = []
        if not self.is_x11:
            return outputs
        try:
            out = subprocess.check_output(["xrandr", "--current"], stderr=subprocess.DEVNULL).decode('utf-8')
            for line in out.splitlines():
                if " connected" in line:
                    match = re.match(r"^([A-Za-z0-9\-]+)\s+connected", line)
                    if match:
                        outputs.append(match.group(1))
        except Exception:
            pass
        return outputs

    def update(self, level, enabled, tint, mode="auto"):
        self.level = max(0, min(90, int(level)))
        self.enabled = enabled
        self.tint = tint
        self.mode = mode
        self.apply()

    def get_rgb_factors(self):
        # Base multiplier from 1.0 (0% dim) down to 0.10 (90% dim)
        factor = (100.0 - self.level) / 100.0 if self.enabled else 1.0

        r, g, b = factor, factor, factor
        if self.tint == "WarmAmber":
            g *= 0.84
            b *= 0.52
        elif self.tint == "Candle":
            g *= 0.70
            b *= 0.38
        elif self.tint == "SoftGreen":
            r *= 0.78
            b *= 0.78
        return r, g, b

    def apply(self):
        use_xrandr = (self.mode == "xrandr" or (self.mode == "auto" and self.is_x11)) and len(self.active_outputs) > 0

        if use_xrandr:
            self.clear_overlays()
            r, g, b = self.get_rgb_factors()
            for out in self.active_outputs:
                try:
                    gamma_str = f"{r:.2f}:{g:.2f}:{b:.2f}"
                    subprocess.run(
                        ["xrandr", "--output", out, "--gamma", gamma_str, "--brightness", "1.0"],
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                        check=False
                    )
                except Exception:
                    pass
        else:
            # Reset X11 gamma first
            self.restore_xrandr()
            self.apply_overlays()

    def apply_overlays(self):
        if not self.enabled or self.level <= 0:
            self.clear_overlays()
            return

        display = Gdk.Display.get_default()
        if not display:
            return

        n_monitors = display.get_n_monitors()
        while len(self.overlay_windows) < n_monitors:
            w = OverlayWindow()
            self.overlay_windows.append(w)

        while len(self.overlay_windows) > n_monitors:
            w = self.overlay_windows.pop()
            w.destroy()

        opacity = self.level / 100.0
        tint_rgb = self.get_tint_rgba()

        for idx, win in enumerate(self.overlay_windows):
            monitor = display.get_monitor(idx)
            if monitor:
                geom = monitor.get_geometry()
                win.move(geom.x, geom.y)
                win.resize(geom.width, geom.height)
            win.update_color(tint_rgb, opacity)
            win.show_all()
            win.make_click_through()

    def get_tint_rgba(self):
        if self.tint == "WarmAmber":
            return (0.18, 0.10, 0.02)
        elif self.tint == "Candle":
            return (0.22, 0.11, 0.03)
        elif self.tint == "SoftGreen":
            return (0.03, 0.15, 0.07)
        return (0.0, 0.0, 0.0)

    def clear_overlays(self):
        for w in self.overlay_windows:
            w.hide()

    def restore_xrandr(self):
        if not self.is_x11:
            return
        for out in self.active_outputs:
            try:
                subprocess.run(
                    ["xrandr", "--output", out, "--gamma", "1.0:1.0:1.0", "--brightness", "1.0"],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    check=False
                )
            except Exception:
                pass

    def cleanup(self):
        self.restore_xrandr()
        self.clear_overlays()


class OverlayWindow(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.POPUP)
        self.set_title("FlickerFreeDimmerOverlay")
        self.set_keep_above(True)
        self.set_app_paintable(True)
        self.set_decorated(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_accept_focus(False)

        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual and screen.is_composited():
            self.set_visual(visual)

        self.color = (0.0, 0.0, 0.0)
        self.opacity = 0.0
        self.connect("draw", self.on_draw)

    def update_color(self, rgb, opacity):
        self.color = rgb
        self.opacity = opacity
        self.queue_draw()

    def on_draw(self, widget, cr):
        cr.set_operator(cairo.OPERATOR_SOURCE)
        r, g, b = self.color
        cr.set_source_rgba(r, g, b, self.opacity)
        cr.paint()
        return False

    def make_click_through(self):
        gdk_win = self.get_window()
        if gdk_win:
            empty_region = cairo.Region()
            gdk_win.input_shape_combine_region(empty_region, 0, 0)


