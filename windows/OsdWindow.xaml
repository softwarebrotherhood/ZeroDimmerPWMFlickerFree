<Window x:Class="AntiFlickerDimmer.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OSD"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        Width="320"
        Height="90">
    <Border Background="#E61A1D20" 
            BorderBrush="#40FFFFFF" 
            BorderThickness="1" 
            CornerRadius="16" 
            Padding="16,12" 
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
        </Border.Effect>
        <Grid VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Row with Icon and Text -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="IconText" Text="🌙" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="FlickerFree Dimmer" FontSize="13" FontWeight="SemiBold" Foreground="#DDFFFFFF" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="PercentText" Text="40%" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- Level Bar -->
            <Grid Grid.Row="1" Height="8">
                <Border Background="#33FFFFFF" CornerRadius="4"/>
                <ProgressBar x:Name="DimmerProgress" Value="40" Maximum="100" Minimum="0" Height="8" BorderThickness="0" Background="Transparent" Foreground="#38BDF8"/>
            </Grid>
        </Grid>
    </Border>
</Window>
