<Window x:Class="AntiFlickerDimmer.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZeroDimmer"
        Width="410"
        Height="530"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource BrushWindowBg}"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        Icon="app.ico">

    <Window.Resources>
        <!-- Theme SolidColorBrushes (Updated Dynamically) -->
        <SolidColorBrush x:Key="BrushWindowBg" Color="#0F172A"/>
        <SolidColorBrush x:Key="BrushWindowBorder" Color="#38BDF8"/>
        <SolidColorBrush x:Key="BrushCardBg" Color="#1E293B"/>
        <SolidColorBrush x:Key="BrushCardBorder" Color="#334155"/>
        <SolidColorBrush x:Key="BrushTextPrimary" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="BrushTextSecondary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="BrushTextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="BrushAccent" Color="#38BDF8"/>
        <SolidColorBrush x:Key="BrushTabContainer" Color="#1E293B"/>
        <SolidColorBrush x:Key="BrushTabContainerBorder" Color="#334155"/>
        <SolidColorBrush x:Key="BrushTabActiveBg" Color="#0F172A"/>
        <SolidColorBrush x:Key="BrushTabInactiveFg" Color="#94A3B8"/>
        <SolidColorBrush x:Key="BrushButtonBg" Color="#334155"/>
        <SolidColorBrush x:Key="BrushButtonHover" Color="#475569"/>
        <SolidColorBrush x:Key="BrushButtonFg" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="BrushChipBg" Color="#1E293B"/>
        <SolidColorBrush x:Key="BrushChipBorder" Color="#334155"/>
        <SolidColorBrush x:Key="BrushChipFg" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="BrushScrollThumb" Color="#334155"/>
        <SolidColorBrush x:Key="BrushTipCardBg" Color="#172554"/>
        <SolidColorBrush x:Key="BrushTipCardBorder" Color="#1E40AF"/>
        <SolidColorBrush x:Key="BrushTipCardTitle" Color="#93C5FD"/>
        <SolidColorBrush x:Key="BrushTipCardText" Color="#BFDBFE"/>
        <SolidColorBrush x:Key="BrushKofiCardBg" Color="#1C1917"/>
        <SolidColorBrush x:Key="BrushKofiCardBorder" Color="#78350F"/>
        <SolidColorBrush x:Key="BrushKofiCardTitle" Color="#F59E0B"/>
        <SolidColorBrush x:Key="BrushKofiCardText" Color="#D6D3D1"/>

        <!-- Windows Fluent Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushButtonBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushButtonFg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource BrushButtonHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows Native Caption Buttons (Minimize & Close) -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol, Arial"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource BrushButtonBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quick Preset Chip Button Style -->
        <Style x:Key="PresetChip" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushChipBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushChipBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushChipFg}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChipBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="{DynamicResource BrushAccent}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Standard Fluent Card Border -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BrushCardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Modern Dark/Light ScrollBar Styles -->
        <Style x:Key="ScrollBarTrackButton" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Rectangle Fill="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder"
                                Background="{DynamicResource BrushScrollThumb}"
                                CornerRadius="3"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Margin="1,0,1,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource BrushAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollBarTrackButton}" Command="{x:Static ScrollBar.PageUpCommand}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernScrollBarThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollBarTrackButton}" Command="{x:Static ScrollBar.PageDownCommand}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows Fluent Segmented Top Tab Bar Styles -->
        <Style x:Key="ModernTabItem" TargetType="{x:Type TabItem}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTabInactiveFg}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,6"
                                Margin="1,0">
                            <ContentPresenter x:Name="TabContent"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource BrushButtonBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource BrushTabActiveBg}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTabControl" TargetType="{x:Type TabControl}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Top Tab Navigation -->
                                <RowDefinition Height="*"/>    <!-- Tab Body Content -->
                            </Grid.RowDefinitions>

                            <!-- Modern Segmented Pill Tab Bar on TOP -->
                            <Border Grid.Row="0"
                                    Background="{DynamicResource BrushTabContainer}"
                                    BorderBrush="{DynamicResource BrushTabContainerBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="2"
                                    Margin="0,0,0,10">
                                <UniformGrid Rows="1" IsItemsHost="True"/>
                            </Border>

                            <!-- Active Tab View -->
                            <Border Grid.Row="1"
                                    Background="Transparent"
                                    BorderThickness="0">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Container -->
    <Border Background="{DynamicResource BrushWindowBg}" 
            BorderBrush="{DynamicResource BrushWindowBorder}" 
            BorderThickness="2" 
            Padding="16,12,16,12"
            SnapsToDevicePixels="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="*"/>    <!-- Tabbed Content -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Fluent Title Bar (Draggable) -->
            <Grid x:Name="TitleBarGrid" Grid.Row="0" MouseLeftButtonDown="OnTitleBarMouseDown" Background="Transparent" Margin="0,0,0,10" Cursor="SizeAll">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="6" Background="Transparent" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Image Source="app.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="ZeroDimmer" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock Text="Zero-Flicker PWM Screen Dimmer" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Windows Native Caption Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Click="OnMinimizeClick" Style="{StaticResource CaptionButton}" ToolTip="Minimize to Tray" Margin="0,0,4,0">
                        <TextBlock Text="&#xE921;" FontWeight="Normal" FontSize="10"/>
                    </Button>
                    <Button Click="OnCloseToTrayClick" Style="{StaticResource CloseCaptionButton}" ToolTip="Close to Tray (Keeps Dimmer Running)">
                        <TextBlock Text="&#xE8BB;" FontWeight="Normal" FontSize="10"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Main Tabbed Content Area -->
            <TabControl Grid.Row="1" Style="{StaticResource ModernTabControl}">

                <!-- ========================================== -->
                <!-- TAB 1: 🎛️ DIMMER (PRIMARY CONTROLS)       -->
                <!-- ========================================== -->
                <TabItem Header="🎛️ Dimmer" Style="{StaticResource ModernTabItem}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                        <StackPanel>
                            <!-- Card 1: Power & Dimming Control -->
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <!-- Master Switch Row -->
                                    <Grid Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Dimmer Status:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                            <Border x:Name="StatusBadge" Background="#14532D" CornerRadius="5" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="StatusBadgeText" Text="ACTIVE" FontSize="10" FontWeight="Bold" Foreground="#4ADE80"/>
                                            </Border>
                                        </StackPanel>
                                        <Button x:Name="PowerToggleButton" Click="OnPowerToggleClick" Style="{StaticResource ModernButton}" Background="#0284C7" HorizontalAlignment="Right" Padding="12,5">
                                            <TextBlock x:Name="PowerButtonText" Text="Turn Off" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                        </Button>
                                    </Grid>

                                    <!-- Percentage & Stepper -->
                                    <Grid Margin="0,0,0,8">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="DimLevelText" Text="35%" FontSize="30" FontWeight="ExtraBold" Foreground="{DynamicResource BrushAccent}"/>
                                            <TextBlock Text="Software Darkness Overlay" FontSize="10" Foreground="{DynamicResource BrushTextMuted}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Width="32" Height="32" Click="OnDecrementDimClick" Style="{StaticResource ModernButton}" Content="-" FontSize="16" Margin="0,0,6,0"/>
                                            <Button Width="32" Height="32" Click="OnIncrementDimClick" Style="{StaticResource ModernButton}" Content="+" FontSize="16"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Slider -->
                                    <Slider x:Name="DimSlider" 
                                            Minimum="0" 
                                            Maximum="90" 
                                            Value="35" 
                                            SmallChange="1" 
                                            LargeChange="5"
                                            ValueChanged="OnDimSliderValueChanged" 
                                            Margin="0,0,0,10"
                                            Height="22"/>

                                    <!-- Quick Presets -->
                                    <TextBlock Text="QUICK PRESETS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,5"/>
                                    <UniformGrid Columns="5" Margin="0,0,0,2">
                                        <Button Content="Off (0%)" Style="{StaticResource PresetChip}" Click="OnPresetClick" Tag="0"/>
                                        <Button Content="20%" Style="{StaticResource PresetChip}" Click="OnPresetClick" Tag="20"/>
                                        <Button Content="40%" Style="{StaticResource PresetChip}" Click="OnPresetClick" Tag="40"/>
                                        <Button Content="60%" Style="{StaticResource PresetChip}" Click="OnPresetClick" Tag="60"/>
                                        <Button Content="80%" Style="{StaticResource PresetChip}" Click="OnPresetClick" Tag="80"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Connected Screens & Monitors -->
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🖥️" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="CONNECTED SCREENS &amp; MONITORS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="ScreenCountText" Text="1 Screen Detected" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccent}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <RadioButton x:Name="ScreenAllRadio" 
                                                 Content="All Connected Screens (All Monitors)" 
                                                 GroupName="ScreenGroup" 
                                                 Foreground="{DynamicResource BrushTextPrimary}" 
                                                 FontWeight="SemiBold" 
                                                 FontSize="11" 
                                                 Margin="0,0,0,5" 
                                                 IsChecked="True" 
                                                 Checked="OnScreenTargetRadioChanged" 
                                                 Tag="All"/>

                                    <RadioButton x:Name="ScreenPrimaryRadio" 
                                                 Content="Primary Screen Only" 
                                                 GroupName="ScreenGroup" 
                                                 Foreground="{DynamicResource BrushTextPrimary}" 
                                                 FontSize="11" 
                                                 Margin="0,0,0,6" 
                                                 Checked="OnScreenTargetRadioChanged" 
                                                 Tag="Primary"/>

                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Target Display:" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox x:Name="ScreenSelectionCombo" 
                                                  Grid.Column="1" 
                                                  SelectionChanged="OnScreenComboChanged" 
                                                  Height="24" 
                                                  FontSize="10" 
                                                  VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Tint & Color Mode -->
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="EYE CARE &amp; NIGHT TINT" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,6"/>
                                    <UniformGrid Columns="2" Rows="2">
                                        <RadioButton x:Name="TintBlackRadio" Content="Neutral Black" GroupName="TintGroup" Foreground="{DynamicResource BrushTextPrimary}" FontSize="11" Margin="0,0,8,6" IsChecked="True" Checked="OnTintRadioChanged" Tag="NeutralBlack"/>
                                        <RadioButton x:Name="TintAmberRadio" Content="Warm Amber" GroupName="TintGroup" Foreground="#F59E0B" FontSize="11" Margin="0,0,0,6" Checked="OnTintRadioChanged" Tag="WarmAmber"/>
                                        <RadioButton x:Name="TintCandleRadio" Content="Cozy Candle" GroupName="TintGroup" Foreground="#F97316" FontSize="11" Margin="0,0,8,2" Checked="OnTintRadioChanged" Tag="Candle"/>
                                        <RadioButton x:Name="TintGreenRadio" Content="Soft Green" GroupName="TintGroup" Foreground="#10B981" FontSize="11" Margin="0,0,0,2" Checked="OnTintRadioChanged" Tag="SoftGreen"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ========================================== -->
                <!-- TAB 2: ⚙️ SYSTEM & ENGINE                  -->
                <!-- ========================================== -->
                <TabItem Header="⚙️ System" Style="{StaticResource ModernTabItem}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                        <StackPanel>
                            <!-- Card: App Appearance / Theme -->
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="APP THEME &amp; APPEARANCE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,6"/>
                                    <UniformGrid Columns="3">
                                        <RadioButton x:Name="ThemeSystemRadio" Content="System (Auto)" GroupName="ThemeGroup" Foreground="{DynamicResource BrushTextPrimary}" FontSize="11" Margin="0,0,4,0" IsChecked="True" Checked="OnThemeRadioChanged" Tag="System"/>
                                        <RadioButton x:Name="ThemeDarkRadio" Content="Dark Mode" GroupName="ThemeGroup" Foreground="{DynamicResource BrushTextPrimary}" FontSize="11" Margin="0,0,4,0" Checked="OnThemeRadioChanged" Tag="Dark"/>
                                        <RadioButton x:Name="ThemeLightRadio" Content="Light Mode" GroupName="ThemeGroup" Foreground="{DynamicResource BrushTextPrimary}" FontSize="11" Margin="0,0,0,0" Checked="OnThemeRadioChanged" Tag="Light"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- Card: Dimming Scope & Taskbar Coverage -->
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="DIMMING ENGINE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,6"/>
                                    <RadioButton x:Name="ModeDwmRadio" Content="Full Desktop &amp; Taskbar (Recommended)" GroupName="MethodGroup" Foreground="{DynamicResource BrushAccent}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3" IsChecked="True" Checked="OnDimmerMethodChanged" Tag="Dwm"/>
                                    <TextBlock Text="Dims entire display uniformly: Taskbar, Start Menu, right-click context menus, and popups. No bright leaks!" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="18,0,0,8" TextWrapping="Wrap" LineHeight="14"/>
                                    <RadioButton x:Name="ModeOverlayRadio" Content="Classic Window Overlay Only" GroupName="MethodGroup" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,2" Checked="OnDimmerMethodChanged" Tag="Overlay"/>
                                </StackPanel>
                            </Border>

                            <!-- Card: UAC "Run as Admin" Dimming -->
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="🔒" FontSize="12" Margin="0,0,5,0"/>
                                        <TextBlock Text="DIM 'RUN AS ADMIN' POPUPS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,8" LineHeight="14">
                                        Prevents un-dimmed flashbangs on administrator elevation dialogs by setting PromptOnSecureDesktop = 0.
                                    </TextBlock>
                                    <Button Content="Dim Administrator Popups" Click="OnFixUacClick" Style="{StaticResource ModernButton}" Background="#0284C7" Foreground="#FFFFFF" HorizontalAlignment="Left" Padding="12,5"/>
                                </StackPanel>
                            </Border>

                            <!-- Card: Preferences -->
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="SYSTEM PREFERENCES" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="StartupCheckBox" Content="Start automatically with Windows" Foreground="{DynamicResource BrushTextPrimary}" FontSize="11" Margin="0,0,0,6" Checked="OnStartupCheckChanged" Unchecked="OnStartupCheckChanged"/>
                                    <CheckBox x:Name="ShowOsdCheckBox" Content="Show on-screen display (OSD) on hotkey" Foreground="{DynamicResource BrushTextPrimary}" FontSize="11" Checked="OnShowOsdCheckChanged" Unchecked="OnShowOsdCheckChanged"/>
                                </StackPanel>
                            </Border>

                            <!-- Card: Window Mobility & Position -->
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="WINDOW MOBILITY &amp; POSITION" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="AllowMoveCheckBox" Content="Allow moving window (draggable)" Foreground="{DynamicResource BrushTextPrimary}" FontSize="11" Margin="0,0,0,4" IsChecked="True" Checked="OnAllowMoveCheckChanged" Unchecked="OnAllowMoveCheckChanged"/>
                                    <TextBlock Text="Drag the top title bar to move the app anywhere on screen. Position is remembered." FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="18,0,0,8" TextWrapping="Wrap" LineHeight="14"/>
                                    <Button Content="📍 Reset Position to Bottom-Right" Click="OnResetPositionClick" Style="{StaticResource ModernButton}" HorizontalAlignment="Left" Padding="12,5"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ========================================== -->
                <!-- TAB 3: 💡 GUIDE & SUPPORT                  -->
                <!-- ========================================== -->
                <TabItem Header="💡 Guide" Style="{StaticResource ModernTabItem}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                        <StackPanel>
                            <!-- Card: Anti-PWM Flicker Tip -->
                            <Border Background="{DynamicResource BrushTipCardBg}" BorderBrush="{DynamicResource BrushTipCardBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="💡" FontSize="13" Margin="0,0,5,0"/>
                                        <TextBlock Text="How to eliminate screen flicker:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTipCardTitle}"/>
                                    </StackPanel>
                                    <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource BrushTipCardText}" LineHeight="14">
                                        Keep laptop hardware brightness (Fn keys) at 100%. At 100%, PWM strobing stops completely. Then, use this app's slider to comfortably dim the screen!
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Card: Global Hotkeys -->
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="GLOBAL HOTKEYS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,3">
                                        <TextBlock Text="Ctrl + Alt + Down" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10"/>
                                        <TextBlock Text="Dim screen (+5%)" Foreground="{DynamicResource BrushTextPrimary}" FontSize="10" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,3">
                                        <TextBlock Text="Ctrl + Alt + Up" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10"/>
                                        <TextBlock Text="Brighten screen (-5%)" Foreground="{DynamicResource BrushTextPrimary}" FontSize="10" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,3">
                                        <TextBlock Text="Ctrl + Alt + D" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10"/>
                                        <TextBlock Text="Toggle Dimmer On/Off" Foreground="{DynamicResource BrushTextPrimary}" FontSize="10" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,2">
                                        <TextBlock Text="Ctrl + Alt + Esc" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10"/>
                                        <TextBlock Text="Emergency Reset (0%)" Foreground="{DynamicResource BrushTextPrimary}" FontSize="10" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card: Support & Ko-fi -->
                            <Border Background="{DynamicResource BrushKofiCardBg}" BorderBrush="{DynamicResource BrushKofiCardBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,6">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="☕" FontSize="13" Margin="0,0,5,0"/>
                                        <TextBlock Text="SUPPORT THE DEVELOPER" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushKofiCardTitle}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource BrushKofiCardText}" Margin="0,0,0,8" LineHeight="14">
                                        If ZeroDimmer has saved your eyes or eliminated migraines, consider buying a coffee!
                                    </TextBlock>
                                    <Button Content="❤️ Support on Ko-fi (softwarebrotherhood)" Click="OnSupportKofiClick" Style="{StaticResource ModernButton}" Background="#FF5E5B" Foreground="#FFFFFF" HorizontalAlignment="Left" Padding="12,5"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Button Content="Hide to Tray" Click="OnCloseToTrayClick" Style="{StaticResource ModernButton}" HorizontalAlignment="Left" Background="{DynamicResource BrushButtonBg}" Foreground="{DynamicResource BrushTextSecondary}" Padding="12,5"/>
                <Button Content="☕ Support on Ko-fi" Click="OnSupportKofiClick" Style="{StaticResource ModernButton}" HorizontalAlignment="Center" Background="#FF5E5B" Foreground="#FFFFFF" Padding="12,5"/>
                <Button Content="Quit Dimmer" Click="OnQuitClick" Style="{StaticResource ModernButton}" HorizontalAlignment="Right" Background="#7F1D1D" Foreground="#FECACA" Padding="12,5"/>
            </Grid>
        </Grid>
    </Border>
</Window>
